NODE_ENV=development
DATABASE_URL=postgresql://alia_runtime:replace-with-app-db-password@127.0.0.1:55432/alia
MIGRATION_DATABASE_URL=postgresql://alia:replace-with-local-password@127.0.0.1:55432/alia
# 32 random bytes in hexadecimal. Used only by db:provision; match DATABASE_URL.
APP_DB_PASSWORD=
# Optional PostgreSQL client binary directory for backup drills.
PG_BIN=
# Separate key for local encrypted restore drills; keep a protected recovery copy.
BACKUP_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3000
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
# Generate 32 random bytes encoded as 64 hexadecimal characters.
MFA_ENCRYPTION_KEY=
SESSION_HOURS=12
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ALIA DENTAL <no-reply@alia.local>
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_WORKER_ENABLED=true
# Explicitly opt in to fictional seed data, never in production.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
# Optional private-file adapter. Upload/download return 503 until configured.
# Absolute directory outside any public/static web directory; dedicated 64-hex key.
PRIVATE_STORAGE_DIR=
PRIVATE_STORAGE_KEY=
